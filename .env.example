# Colour variant: 'red' | 'graphite' | 'chrome'. Defaults to 'red'.
# Inlined at build time - changing this requires a rebuild.
NEXT_PUBLIC_THEME=red

# Canonical site URL, used by sitemap.xml, robots.txt and Open Graph.
NEXT_PUBLIC_SITE_URL=https://bowralwheelrepairs.com.au

# BusinessBrain platform integration. Unset until the site is registered in
# brain.tenant_websites; app/api/contact/route.ts falls back gracefully and
# still accepts submissions without them.
# BB_TENANT_ID=
# BB_WEBHOOK_SECRET=
# BB_WEBHOOK_URL=
